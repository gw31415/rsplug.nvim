-- Auto generated by rsplug
if vim.g.rsplug_loaded or not vim.o.loadplugins then
	return
end
vim.g.rsplug_loaded = true

local source = debug.getinfo(1, 'S').source
source = source:sub(1, 1) == '@' and source:sub(2) or source

local root = vim.fn.fnamemodify(vim.fn.resolve(source), ':h:h')

vim.opt.packpath:prepend(root)

<% if !control_ids.is_empty() { %>local requested = vim.env.RSPLUG_GENERATION
local ids = { <% for id in control_ids {%><%=lua_string(id)%>,<%}%> }
if requested ~= nil and requested ~= ''
	and #requested == 32
	and string.match(requested, '^[0-9a-fA-F]+$') ~= nil
	and vim.fn.filereadable(root .. '/generations/' .. string.lower(requested) .. '.lua') == 1
then
	ids = { string.lower(requested) }
elseif requested ~= nil and requested ~= '' then
	vim.notify(('[rsplug] RSPLUG_GENERATION %q is not available, falling back to the default generation'):format(requested), vim.log.levels.WARN)
end
for _, id in ipairs(ids) do
	-- :packadd は 'packpath' 全体の glob と runtimepath 各エントリの realpath 解決で遅いため、
	-- :packadd! と同じ位置 (最初の after ディレクトリの直前) に直接足す。
	-- エスケープされた区切りを含む runtimepath は分割できないので :packadd! に任せる。
	local dir = root .. '/pack/_gen/opt/' .. id
	local rtp = vim.o.runtimepath
	if rtp:find('\\', 1, true) then
		vim.cmd('packadd! ' .. vim.fn.fnameescape(id))
	elseif not (',' .. rtp .. ','):find(',' .. dir .. ',', 1, true) then
		local entries = vim.split(rtp, ',', { plain = true })
		local pos = #entries + 1
		for i, entry in ipairs(entries) do
			if entry:match('/after/?$') then
				pos = i
				break
			end
		end
		table.insert(entries, pos, dir)
		vim.o.runtimepath = table.concat(entries, ',')
	end
	-- 起動スクリプトは plugin/ に置かない。init 中に source した plugin/ は
	-- 直後の load-plugins でもう一度 source されるため、ここで1回だけ source する。
	local scripts = vim.fn.glob(root .. '/pack/_gen/opt/' .. id .. '/rsplug/startup/*.lua', true, true)
	table.sort(scripts)
	for _, script in ipairs(scripts) do
		vim.cmd.source(vim.fn.fnameescape(script))
	end
end

local ok, rsplug = pcall(require, '_rsplug')
if not ok then
	error('[rsplug] failed to load generated runtime: ' .. tostring(rsplug))
end

rsplug.startup()
<% } %>
